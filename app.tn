<html>
  <input id="userName" value="Jules">
  <button id="saveBtn" onclick="guardarProgreso()">Guardar en Storage</button>
  <p id="status">Esperando accion...</p>
</html>

<script>
function guardarProgreso() {
  let nombre = 'Usuario';
  console.log('Guardando...');
  // Esto seria evaluado por QuickJS
  storage.set('user', nombre);
  document.getElementById('status').innerText = 'Progreso Guardado con exito'
}
</script>
