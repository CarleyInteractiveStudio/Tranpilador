<html>
  <button id="btn1" onclick="mejorarApp()">Mejorar Diseño</button>
  <p id="txt1">Contador: 0</p>
</html>

<style>
#btn1 {
  background-color: #4CAF50;
}
#txt1 {
  background-color: #f1f1f1;
}
</style>

<script>
let clicks = 0;
function mejorarApp() {
  clicks = clicks + 1;
  document.getElementById('txt1').innerText = 'Has pulsado el boton'
  document.getElementById('txt1').style.backgroundColor = '#2196F3'
  document.getElementById('btn1').style.backgroundColor = '#FF9800'
}
</script>
