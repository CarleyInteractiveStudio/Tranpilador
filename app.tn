<html>
  <div id="container">
    <button id="btn1" onclick="descargarDatos()">Cargar Info</button>
    <p id="info">Esperando datos...</p>
  </div>
</html>

<style>
#container {
  display: flex;
  flex-direction: row;
}
#btn1 {
  background-color: #2c3e50;
}
</style>

<script>
function handleResponse(data) {
  document.getElementById('info').innerText = 'Datos Recibidos: ' + data
}

function descargarDatos() {
  fetch('https://api.test.com/data').then(res => handleResponse(res))
}
</script>
